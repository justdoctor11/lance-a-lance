<?xml version="1.0" encoding="utf-8"?>
<!-- Widget da tela inicial: um cartão por dia (frase, partida célebre ou peça) desenhado pelo app,
     com a sequência, a meta de hoje e as revisões numa faixa embaixo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:background="@drawable/lal_widget_bg">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/w_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/w_kick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PEÃO PASSADO"
                    android:textColor="#E0AD4C"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/w_title_q"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:textStyle="italic"
                    android:textColor="#F4EFE2"
                    android:lineSpacingMultiplier="1.05"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/w_title_b"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="3dp"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textColor="#F4EFE2"
                    android:text="Abra o app para começar"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeMaxTextSize="19sp"
                    android:autoSizeStepGranularity="1sp" />
                <TextView
                    android:id="@+id/w_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#C9D0CB"
                    android:textSize="10sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:id="@+id/w_fig"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.85"
                android:layout_marginStart="6dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/w_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F4EFE2"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/w_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:text="dias"
                android:textColor="#B9C2BC"
                android:textSize="10sp"
                android:maxLines="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:text="Hoje "
                android:textColor="#B9C2BC"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/w_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/10"
                android:textColor="#F4EFE2"
                android:textSize="10sp"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/w_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="8dp"
                android:max="10"
                android:progress="0"
                android:progressTint="#E0AD4C"
                android:progressBackgroundTint="#40FFFFFF" />
            <TextView
                android:id="@+id/w_rep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#F4EFE2"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="3dp"
                android:text="rev."
                android:textColor="#B9C2BC"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
