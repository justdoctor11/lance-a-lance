{
  "name": "lance-a-lance",
  "productName": "Peão Passado",
  "version": "1.4.0",
  "description": "Treinador de xadrez: análise lance a lance, teoria, armadilhas e treino a partir das suas partidas.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win --x64 --publish never",
    "android:prepare": "npm run build:web && npx cap add android && npx capacitor-assets generate --android && npx cap sync android && node scripts/android-native.mjs"
  },
  "build": {
    "appId": "app.lancealance.coach",
    "productName": "Peão Passado",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "www/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Peao-Passado-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Peao-Passado-Portatil-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "justdoctor11",
        "repo": "lance-a-lance",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.4",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/share": "6.0.4",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "minShell": "1.1.0"
}
